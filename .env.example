# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# ── Supabase client (for storage / realtime if needed) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ── NextAuth / Auth.js ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
# The URL your app is deployed at (no trailing slash)
AUTH_URL="http://localhost:3000"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Anthropic (AI advisor) ────────────────────────────────────────────────────
# Never expose this to the browser — only used in API routes
ANTHROPIC_API_KEY="sk-ant-..."

# ── PayPal (sandbox for dev, live for prod) ───────────────────────────────────
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
# Client ID is public (NEXT_PUBLIC_); secret is server-only
NEXT_PUBLIC_PAYPAL_CLIENT_ID="AaBbCcDdEeFfGgHhIiJj..."
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
# Override to switch to live: https://api-m.paypal.com
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="Guitar Shop <orders@yourdomain.com>"
